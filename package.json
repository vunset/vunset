{
  "name": "vunset",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/utils",
    "packages/vue",
    "packages/ui",
    "packages/nuxt"
  ],
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vitepress build docs",
    "build:lib": "npm run build --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "bump": "node scripts/version.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/charts": "^1.1.0",
    "@tanstack/vue-table": "^9.2.4",
    "@tanstack/vue-virtual": "^3.13.40",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "^5.0.1",
    "vue": "^3.5.43",
    "vue-component-meta": "^3.3.11",
    "vue-tsc": "^3.3.11"
  }
