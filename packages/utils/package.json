{
  "name": "@vunset/utils",
  "version": "1.0.0-rc.2",
  "description": "Plain, dependency-free helpers for dates, numbers, strings, CSV, chart colors and SVG parsing.",
  "keywords": [
    "utils",
    "helpers",
    "date",
    "format",
    "number",
    "csv",
    "svg",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vunset/vunset.git",
    "directory": "packages/utils"
  },
  "homepage": "https://vunset.com/helpers/dates",
  "bugs": "https://github.com/vunset/vunset/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
