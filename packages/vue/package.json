{
  "name": "@vunset/vue",
  "version": "1.0.0-rc.1",
  "description": "Headless, unstyled Vue 3 components: keyboard, focus and ARIA handled, the look left to you.",
  "keywords": [
    "vue",
    "vue3",
    "headless",
    "unstyled",
    "components",
    "ui",
    "accessibility",
    "a11y",
    "aria",
    "component-library"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vunset/vunset.git",
    "directory": "packages/vue"
  },
  "homepage": "https://vunset.github.io/vunset/get-started",
  "bugs": "https://github.com/vunset/vunset/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chart": {
      "types": "./dist/chart.d.ts",
      "import": "./dist/chart.js"
    },
    "./data-table": {
      "types": "./dist/data-table.d.ts",
      "import": "./dist/data-table.js"
    }
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@floating-ui/vue": "^2.0.1",
    "@vunset/utils": "1.0.0-rc.1",
    "d3-shape": "^3.2.0"
  },
  "peerDependencies": {
    "@tanstack/charts": "^1.1.0",
    "@tanstack/vue-table": "^9.2.4",
    "vue": "^3.5.43"
  },
  "peerDependenciesMeta": {
    "@tanstack/charts": {
      "optional": true
    },
    "@tanstack/vue-table": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
